# Normaliza fins de linha: LF no repositório, conversão automática no checkout.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.sh        text eol=lf
*.ps1       text eol=crlf

# Binários
*.png binary
*.jpg binary
*.ico binary
*.dll binary
